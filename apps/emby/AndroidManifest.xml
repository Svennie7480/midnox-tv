        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout" android:windowSoftInputMode="stateHidden|adjustNothing">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
        <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
      </intent-filter>
    </activity>
    <provider android:name=".UpdateProvider" android:authorities="de.midnox.emby.apk" android:exported="false" android:grantUriPermissions="true"/>
  </application>
</manifest>
