<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="de.midnox.emby" android:versionCode="11" android:versionName="2.1.3">
  <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="35"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <queries>
    <package android:name="com.teamsmart.videomanager.tv"/>
    <package android:name="com.liskovsoft.smarttubetv.beta"/>
    <package android:name="com.liskovsoft.smarttubetv"/>
    <package android:name="com.amazon.firetv.youtube"/>
    <package android:name="com.google.android.youtube.tv"/>
    <package android:name="com.google.android.youtube"/>
    <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="https"/></intent>
    <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="http"/></intent>
  </queries>
  <uses-feature android:name="android.software.leanback" android:required="false"/>
  <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
  <application android:label="midnox Media" android:icon="@drawable/icon" android:banner="@drawable/banner"
      android:allowBackup="false" android:usesCleartextTraffic="true" android:hardwareAccelerated="true" android:theme="@style/Midnox" android:largeHeap="true">
    <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="unspecified" android:launchMode="singleTask" android:resizeableActivity="true" android:supportsPictureInPicture="true"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density" android:windowSoftInputMode="stateHidden|adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
        <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
      </intent-filter>
    </activity>
    <service android:name=".PlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
    <provider android:name=".UpdateProvider" android:authorities="de.midnox.emby.apk" android:exported="false" android:grantUriPermissions="true"/>
  </application>
</manifest>
